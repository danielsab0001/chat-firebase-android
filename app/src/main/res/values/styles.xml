<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Botón principal: relleno, esquinas suaves, sin mayúsculas -->
    <style name="Widget.Chat.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Botón secundario: solo texto -->
    <style name="Widget.Chat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Campos de texto con borde y esquinas suaves -->
    <style name="Widget.Chat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
    </style>

    <!-- Tipografía: tres niveles -->
    <style name="TextAppearance.Chat.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Chat.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Chat.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Barra superior: superficie del tema, título en negrita -->
    <style name="Widget.Chat.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/on_surface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Chat.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.Chat.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_toolbar</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Campo de texto redondeado: caja de mensaje y buscador -->
    <style name="Widget.Chat.RoundedInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_message</item>
        <item name="android:minHeight">@dimen/input_min_height</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- Esquinas redondeadas para las fotos del chat -->
    <style name="ShapeAppearance.Chat.Image" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <string name="login_subtitle">Inicia sesión para continuar</string>
    <string name="register_subtitle">Crea tu cuenta para empezar a chatear</string>
    <string name="hint_search">Buscar usuario</string>
    <string name="no_results">No se encontraron usuarios</string>

</resources>