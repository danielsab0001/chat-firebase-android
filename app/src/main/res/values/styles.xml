<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Botón principal: relleno, esquinas suaves, sin mayúsculas -->
    <style name="Widget.Chat.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Botón secundario: solo texto -->
    <style name="Widget.Chat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Campos de texto con borde y esquinas suaves -->
    <style name="Widget.Chat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_m</item>
    </style>

    <!-- Tipografía: tres niveles -->
    <style name="TextAppearance.Chat.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Chat.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.Chat.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
</resources>